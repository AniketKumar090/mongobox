# YouTube Data API v3 Key
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Anthropic (Claude) API Key
# Keep this secret. Do not commit real keys.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SoundCloud (used for background audio "mirror" playback)
# Register an application at https://developers.soundcloud.com/
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret_here

# Voice backend — after `cd voice-backend && python start.py`, copy the printed DEVICE_URL line into .env.
VOICE_BACKEND_URL=http://127.0.0.1:8000
# Uncomment on a physical iPhone (same Wi-Fi as your Mac):
# VOICE_BACKEND_DEVICE_URL=http://192.168.1.42:8000
